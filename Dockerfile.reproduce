# syntax=docker/dockerfile:1
#
# mp-spice -- reproduce the README's results on a compute cluster.
#
# Self-contained and OFFLINE-CAPABLE at run time: the solver binaries, the
# SuiteSparse matrices behind every README table (downloaded once, at build
# time), the analysis scripts, and a PROVENANCE.txt recording exactly which
# source revisions were compiled are all baked in. Compute nodes without
# internet access need nothing but the image and a writable results directory.
#
# BUILD  (needs internet; context = the directory holding BOTH mp-spice/ and mtl5/):
#
#   cd ~/Desktop/LFX
#   docker build -f mp-spice/Dockerfile.reproduce \
#       --build-arg UNIVERSAL_REF=$(git -C /path/to/your/universal rev-parse HEAD) \
#       -t mp-spice-repro:latest .
#
#   UNIVERSAL_REF matters: mp-spice's CMake fetches Universal at `main`, which
#   moves. Pass the commit your README numbers were produced with (the SHA of
#   your local universal checkout) or you are reproducing against a different
#   number library than the one that produced them. Left at the default `main`,
#   the build still works, and PROVENANCE.txt records which commit `main` was.
#
#   This image compiles your LOCAL mtl5 checkout (the `quire-instrumentation`
#   branch carries accumulator-seam / instrumentation changes that are not on
#   origin/main -- see Dockerfile). PROVENANCE.txt lists any uncommitted changes
#   in the compiled source paths, so a "reproduction" of uncommitted code is
#   visible as such rather than silently passing as a clean commit.
#
#   Other build args:
#     BUILD_JOBS=4        parallel compile jobs (Universal templates are memory
#                         hungry -- raise it only if the build host has the RAM)
#     FETCH_MATRICES=0    skip the matrix download (then mount them at /opt/mp-spice/data)
#     MATRIX_LIST="..."   matrices to bake in (default: every matrix behind a README table)
#
# RUN, single machine (Docker):
#
#   docker run --rm -v $PWD/results:/results mp-spice-repro:latest all
#   docker run --rm mp-spice-repro:latest list                      # matrix -> array index
#   docker run --rm -v $PWD/results:/results mp-spice-repro:latest all --matrices "rajat11 rajat14"
#
# RUN, Slurm + Apptainer/Singularity (most HPC sites do not run Docker):
#
#   apptainer build mp-spice-repro.sif docker-daemon://mp-spice-repro:latest
#   # (or push to a registry and: apptainer build mp-spice-repro.sif docker://REGISTRY/mp-spice-repro:latest)
#   sbatch scripts/reproduce.sbatch          # one array task per matrix
#   # once the array finishes:
#   apptainer run --bind $PWD/results:/results mp-spice-repro.sif merge
#
# RUN, Kubernetes: an Indexed Job (completions=14, parallelism=N) whose command is
#   ["/opt/mp-spice/scripts/reproduce_readme.sh","run","--out","/results"]
#   picks its matrix from JOB_COMPLETION_INDEX automatically; run `merge` once after.
#
# The binaries are compiled WITHOUT -march=native, so one image runs on a
# heterogeneous cluster (mixed CPU generations) without illegal-instruction crashes.
# The image runs as whatever UID the scheduler gives it: nothing needs root,
# /results is world-writable, HOME points at /tmp.

ARG BASE=ubuntu:22.04

# ---------------------------------------------------------------- matrices --
# Separate stage, copied before any source, so editing code never re-downloads
# the matrices (and re-downloading never rebuilds the code).
FROM ${BASE} AS matrices
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates tar gzip && \
    rm -rf /var/lib/apt/lists/*
COPY mp-spice/scripts/fetch_matrices.sh /opt/fetch/scripts/fetch_matrices.sh
ARG FETCH_MATRICES=1
ARG MATRIX_LIST="rajat04 rajat05 rajat11 rajat12 rajat13 rajat14 rajat15 rajat16 rajat17 rajat19 add20 add32 rajat30 rajat03"
RUN chmod +x /opt/fetch/scripts/fetch_matrices.sh && mkdir -p /data && \
    if [ "$FETCH_MATRICES" = "1" ]; then \
        DATA_DIR=/data /opt/fetch/scripts/fetch_matrices.sh $MATRIX_LIST \
          || echo "WARNING: some matrices failed to download -- see above; the run step reports them as MISSING" ; \
    fi && \
    ( cd /data && find . -name '*.mtx' -print0 | sort -z | xargs -0 -r sha256sum > MANIFEST.sha256 ) ; \
    echo "baked-in matrices:" && cat /data/MANIFEST.sha256 2>/dev/null || true

# ------------------------------------------------------------------ builder --
FROM ${BASE} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
ARG UNIVERSAL_REPO=https://github.com/stillwater-sc/universal.git
ARG UNIVERSAL_REF=main
# fetch exactly one revision (works for branch names, tags, and full SHAs on GitHub)
RUN git init -q universal && cd universal && \
    git remote add origin "${UNIVERSAL_REPO}" && \
    git fetch -q --depth 1 origin "${UNIVERSAL_REF}" && \
    git checkout -q FETCH_HEAD

COPY mtl5/ mtl5/
COPY mp-spice/ mp-spice/

# Build dir is /build, NOT mp-spice/build: a host build/ directory in the context
# carries a CMakeCache.txt from another machine and CMake refuses to reuse it.
# No -march=native, on purpose (see header). Only the two apps the README needs.
ARG BUILD_JOBS=4
RUN cmake -B /build -S mp-spice \
      -DCMAKE_BUILD_TYPE=Release \
      -DMPSPICE_MIXED_PRECISION_KLU=ON \
      -DMPSPICE_BUILD_TESTS=OFF \
      -DFETCHCONTENT_SOURCE_DIR_MTL5=/src/mtl5 \
      -DFETCHCONTENT_SOURCE_DIR_UNIVERSAL=/src/universal \
      -Wno-dev && \
    cmake --build /build -j"${BUILD_JOBS}"

# What was compiled. `status` is limited to the source paths that affect the
# binaries so excluded/untracked bulk (data, logs, build dirs) doesn't inflate it.
RUN { \
      echo "image built:  $(date -u +%FT%TZ)"; \
      echo "mp-spice:     $(git -C mp-spice rev-parse HEAD 2>/dev/null || echo unknown)"; \
      echo "  uncommitted source changes: $(git -C mp-spice status --porcelain -- include applications CMakeLists.txt 2>/dev/null | wc -l) file(s)"; \
      echo "mtl5:         $(git -C mtl5 rev-parse HEAD 2>/dev/null || echo unknown)  branch: $(git -C mtl5 rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"; \
      echo "  uncommitted source changes: $(git -C mtl5 status --porcelain -- include 2>/dev/null | wc -l) file(s)"; \
      echo "universal:    $(git -C universal rev-parse HEAD)  (requested: ${UNIVERSAL_REF})"; \
      echo "compiler:     $(g++ --version | head -1)"; \
      echo "cmake:        $(cmake --version | head -1)"; \
      echo "flags:        Release, no -march=native"; \
    } > /PROVENANCE.txt && cat /PROVENANCE.txt

# ------------------------------------------------------------------ runtime --
FROM ${BASE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 python3 python3-pandas python3-matplotlib bash curl ca-certificates tar gzip && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/applications/klu_quire_IR_study/klu_quire_IR_study /usr/local/bin/
COPY --from=builder /build/applications/klu_quire_study/klu_quire_study       /usr/local/bin/

COPY --from=builder /src/mp-spice/scripts/                           /opt/mp-spice/scripts/
COPY --from=builder /src/mp-spice/csv/normalize_dynamic_range.py     /opt/mp-spice/csv/
COPY --from=builder /src/mp-spice/csv/plot_dynamic_range.py          /opt/mp-spice/csv/
COPY --from=builder /src/mp-spice/ci/                                /opt/mp-spice/ci/
COPY --from=builder /src/mp-spice/README.md                          /opt/mp-spice/README.md
COPY --from=builder /PROVENANCE.txt                                  /opt/mp-spice/PROVENANCE.txt
COPY --from=matrices /data                                           /opt/mp-spice/data

# Readable/executable by any UID (host file modes can be 0600), writable results dir.
RUN chmod -R a+rX /opt/mp-spice && chmod a+x /opt/mp-spice/scripts/*.sh && \
    mkdir -p /results && chmod 1777 /results

ENV MPSPICE_ROOT=/opt/mp-spice \
    DATA_DIR=/opt/mp-spice/data \
    MPLBACKEND=Agg \
    MPLCONFIGDIR=/tmp/mplconfig \
    HOME=/tmp

WORKDIR /results
LABEL org.opencontainers.image.title="mp-spice README reproduction" \
      org.opencontainers.image.authors="shreebhargavkomanabelli"

ENTRYPOINT ["/opt/mp-spice/scripts/reproduce_readme.sh"]
CMD ["all"]
